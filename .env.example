# Copie para .env e preencha. O arquivo .env NÃO deve ir para o Git.

# Endereço do sistema.
#   Na internet: o domínio que aponta para o servidor, ex.: vendas.minhaloja.com.br
#   Na rede local, sem domínio: :80   (e use COOKIE_SEGURO=0 logo abaixo)
DOMINIO=vendas.minhaloja.com.br

# 1 = login só funciona por HTTPS (internet). 0 = permite HTTP (somente rede local).
COOKIE_SEGURO=1

# Primeiro gerente, criado na primeira subida se ainda não existir nenhum.
# Depois de entrar, troque a senha em "Minha conta". Mudar estes valores depois não altera nada.
ADMIN_LOGIN=gerente
ADMIN_SENHA=troque-esta-senha-agora

# 1 = documentação da API em /docs. Em produção, deixe 0.
DOCS=0
